@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Malformed/adversarial: two blank-node owl:intersectionOf class expressions
# whose member lists reference each other, creating a cycle in the
# anonymous-class-expression dependency graph. #363.

:A rdf:type owl:Class .

_:x
    rdf:type owl:Class ;
    owl:intersectionOf ( :A _:y ) .

_:y
    rdf:type owl:Class ;
    owl:intersectionOf ( :A _:x ) .

_:x rdfs:subClassOf :A .
