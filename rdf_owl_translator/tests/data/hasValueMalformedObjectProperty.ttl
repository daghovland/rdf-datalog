@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix : <http://example.org/> .

# owl:hasValue restriction on an object property whose owl:hasValue object is
# (malformed) a literal instead of an individual. Regression/fix coverage for
# #363: try_get_individual must not panic; the restriction falls back to
# owl:Thing (with a log::warn!) instead of crashing the translation.
:likes a owl:ObjectProperty .

:Fan rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :likes ;
    owl:hasValue "not an individual"
] .
