@prefix ottr: <http://ns.ottr.xyz/0.4/> .
@prefix ex: <http://example.com/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:Inner a ottr:Template ;
    ottr:parameters ( [ ottr:type ottr:IRI ; ottr:variable _:x ] ) ;
    ottr:pattern
        [ ottr:of ottr:Triple ;
          ottr:values ( _:x rdf:type ex:Inner ) ] .

ex:Outer a ottr:Template ;
    ottr:parameters ( [ ottr:type ottr:IRI ; ottr:variable _:y ] ) ;
    ottr:pattern
        [ ottr:of ex:Inner ;
          ottr:values ( _:y ) ] .

[] ottr:of ex:Outer ;
   ottr:values ( ex:Foo ) .
