@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bl: <https://dagalog.no/ns/backlog#> .
@prefix crate: <https://dagalog.no/ns/backlog/crate#> .
@prefix ghissues: <https://github.com/daghovland/rdf-datalog/issues/> .
@prefix ghpull: <https://github.com/daghovland/rdf-datalog/pull/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Vocabulary reference ────────────────────────────────────────────────────
#
# See ../ontology/vocabulary.ttl for the actual formal ontology and
# ../ontology/MODELING_NOTES.md for the reasoning. Subjects are the real
# GitHub issue/PR URLs (already globally unique IRIs, no invented identifier
# scheme needed). Every fact below reflects this repo's actual state as of
# 2026-07-25 — see README.md for exactly which parts are a complete slice
# vs. a deliberately partial one (the #178 section).
#
# bl:number          xsd:integer            issue/PR number, for display
# rdfs:label         xsd:string             issue/PR title (RDFS's own property, not bespoke)
# bl:state           bl:Open | bl:Closed    controlled-vocabulary object property
# bl:hasLabel        bl:Label               GitHub label, as a resource (repeatable)
# bl:subIssueOf       <issue>                parent issue (native GitHub sub-issue relation)
# bl:closesIssue     <issue>                PR -> issue, formally closes it on merge
# bl:relatesToIssue  <issue>                PR -> issue, references without closing
# bl:touchesCrate    bl:Crate               issue/PR -> crate(s) it actually changed;
#                                           see crates_and_dependencies.ttl for bl:Crate
#
# "Epic" is now an asserted rdf:type (bl:Epic, rdfs:subClassOf bl:Issue),
# constrained (see ../ontology/shapes.ttl) to never itself carry
# bl:subIssueOf, but NOT required to have any bl:subIssueOf children.

# ── Epic #267: SHACL correctness audit — mostly done, 2 of 9 still open ───

ghissues:267
    a bl:Issue, bl:Epic, bl:WorkItem ;
    bl:number 267 ;
    rdfs:label "SHACL correctness audit (2026-07-23): tracking issue" ;
    bl:state bl:Open ;
    bl:hasLabel bl:Bug, bl:Ready .

ghissues:258
    a bl:Issue, bl:WorkItem ;
    bl:number 258 ;
    rdfs:label "BUG: sh:or/sh:not/sh:and/sh:node/sh:xone/sh:qualifiedValueShape use an incomplete inner-shape checker" ;
    bl:state bl:Closed ;
    bl:hasLabel bl:Bug, bl:Ready ;
    bl:subIssueOf ghissues:267 .

