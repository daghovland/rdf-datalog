# ── Epic #178 (partial slice): closesIssue vs. relatesToIssue nuance ───────
#
# NOT a complete child list for #178 — it also has sub-issues #157 and #179,
# omitted here since they're irrelevant to the point this section exists to
# make. Do not use this section as an example of "all of an epic's children"
# the way the #267 and #282 sections above are.

ghissues:178
    a bl:Issue, bl:Epic, bl:WorkItem ;
    bl:number 178 ;
    rdfs:label "OWL Manchester Syntax: parsing, serialization, and full integration (epic)" ;
    bl:state bl:Open ;
    bl:hasLabel bl:Enhancement, bl:Ready .

ghissues:160
    a bl:Issue, bl:WorkItem ;
    bl:number 160 ;
    rdfs:label "Manchester Syntax: serializer (owl_ontology::Ontology → .omn)" ;
    bl:state bl:Closed ;
    bl:hasLabel bl:Ready ;
    bl:subIssueOf ghissues:178 .

ghpull:288 a bl:PullRequest, bl:WorkItem ;
    bl:number 288 ;
    rdfs:label "Add Manchester Syntax serializer (manchester_parser::serialize)" ;
    bl:state bl:Closed ;
    bl:closesIssue ghissues:160 ;
    bl:touchesCrate crate:manchester_parser .

ghissues:161
    a bl:Issue, bl:WorkItem ;
    bl:number 161 ;
    rdfs:label "Manchester Syntax: wire serializer into CLI/kernel/HTTP content negotiation" ;
    bl:state bl:Open ;
    bl:hasLabel bl:Ready ;
    bl:subIssueOf ghissues:178 ;
    bl:touchesCrate crate:dagalog, crate:dagalog_kernel, crate:sparql_endpoint .
    # Still open on purpose: PR #292 implemented only part of this issue's
    # scope (CLI + kernel wiring, not HTTP content negotiation) and
    # deliberately did NOT close it — see bl:relatesToIssue below. A loader
    # (#284) or human naively assuming "merged PR mentioning #161 == #161
    # done" would get this wrong; that's exactly the distinction
    # bl:closesIssue vs. bl:relatesToIssue exists to preserve.

ghpull:292 a bl:PullRequest, bl:WorkItem ;
    bl:number 292 ;
    rdfs:label "Wire Manchester Syntax (.omn) into CLI and notebook kernel" ;
    bl:state bl:Closed ;
    bl:relatesToIssue ghissues:161 ;
    bl:touchesCrate crate:dagalog, crate:dagalog_kernel .

