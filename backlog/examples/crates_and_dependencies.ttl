@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bl: <https://dagalog.no/ns/backlog#> .
@prefix crate: <https://dagalog.no/ns/backlog/crate#> .

# Extends the ticket-tracking fixtures with the codebase itself: every
# workspace crate (from the root Cargo.toml's `members` list, as of
# 2026-07-24) plus its real path-dependency edges (from each crate's own
# Cargo.toml [dependencies] section) — not invented, read directly off the
# actual workspace. Lets #285/#286 answer questions like "which crates have
# open bugs" or "what depends on shacl" by joining bl:touchesCrate (added to
# the relevant PRs in valid_backlog_snapshot.ttl) against this dependency
# graph.
#
# bl:Crate    -- a workspace member crate
# rdfs:label  -- xsd:string, the Cargo package name (not always == dir name,
#                e.g. dir `dag_rdf` is package `dag-rdf`) -- not a bespoke
#                bl:name property, see ../ontology/MODELING_NOTES.md
#                "rdfs:label instead of a bespoke bl:title" (same reasoning
#                applies here)
# bl:path     -- xsd:string, workspace-relative directory
# bl:dependsOnCrate -- bl:Crate -> bl:Crate, direct path dependency
#
# See ../ontology/vocabulary.ttl for the formal class declaration and
# ../ontology/MODELING_NOTES.md's "DOAP vs. bespoke bl:Crate" for why
# bl:Crate is NOT a DOAP subclass (DOAP has no submodule/component concept
# that fits an internal, never-independently-published workspace crate --
# only project_and_status.ttl's repo-level doap:Project reuses DOAP).

crate:ingress a bl:Crate ; rdfs:label "ingress" ; bl:path "ingress" .
crate:dag_rdf a bl:Crate ; rdfs:label "dag-rdf" ; bl:path "dag_rdf" ;
    bl:dependsOnCrate crate:ingress .
crate:owl_ontology a bl:Crate ; rdfs:label "owl-ontology" ; bl:path "owl_ontology" ;
    bl:dependsOnCrate crate:ingress .
crate:turtle a bl:Crate ; rdfs:label "turtle" ; bl:path "turtle" ;
    bl:dependsOnCrate crate:dag_rdf .
crate:sparql_parser a bl:Crate ; rdfs:label "sparql-parser" ; bl:path "sparql_parser" ;
    bl:dependsOnCrate crate:dag_rdf, crate:ingress .
crate:datalog a bl:Crate ; rdfs:label "datalog" ; bl:path "datalog" ;
    bl:dependsOnCrate crate:dag_rdf, crate:sparql_parser .
crate:eli a bl:Crate ; rdfs:label "eli" ; bl:path "eli" ;
    bl:dependsOnCrate crate:ingress, crate:dag_rdf, crate:datalog, crate:owl_ontology .
crate:owl2rl2datalog a bl:Crate ; rdfs:label "owl2rl2datalog" ; bl:path "owl2rl2datalog" ;
    bl:dependsOnCrate crate:ingress, crate:dag_rdf, crate:datalog, crate:owl_ontology, crate:eli .
crate:manchester_parser a bl:Crate ; rdfs:label "manchester-parser" ; bl:path "manchester_parser" ;
    bl:dependsOnCrate crate:dag_rdf, crate:owl_ontology, crate:ingress .
crate:datalog_parser a bl:Crate ; rdfs:label "datalog-parser" ; bl:path "datalog_parser" ;
    bl:dependsOnCrate crate:dag_rdf, crate:datalog, crate:sparql_parser .
crate:rdf_owl_translator a bl:Crate ; rdfs:label "rdf-owl-translator" ; bl:path "rdf_owl_translator" ;
    bl:dependsOnCrate crate:dag_rdf, crate:ingress, crate:owl_ontology, crate:turtle .
crate:jsonld_parser a bl:Crate ; rdfs:label "jsonld-parser" ; bl:path "jsonld_parser" ;
    bl:dependsOnCrate crate:dag_rdf, crate:ingress .
crate:shacl a bl:Crate ; rdfs:label "shacl" ; bl:path "shacl" ;
    bl:dependsOnCrate crate:dag_rdf, crate:datalog, crate:ingress .
crate:rml a bl:Crate ; rdfs:label "rml" ; bl:path "rml" ;
    bl:dependsOnCrate crate:ingress, crate:dag_rdf, crate:turtle .
crate:ottr a bl:Crate ; rdfs:label "ottr" ; bl:path "ottr" ;
    bl:dependsOnCrate crate:ingress, crate:dag_rdf .
crate:vqs_index a bl:Crate ; rdfs:label "vqs-index" ; bl:path "vqs_index" ;
    bl:dependsOnCrate crate:dag_rdf, crate:ingress, crate:sparql_parser, crate:turtle .
crate:rdf_canon a bl:Crate ; rdfs:label "rdf-canonicalization" ; bl:path "rdf_canon" ;
    bl:dependsOnCrate crate:dag_rdf, crate:ingress .
crate:sparql_endpoint a bl:Crate ; rdfs:label "sparql-endpoint" ; bl:path "sparql_endpoint" ;
    bl:dependsOnCrate crate:dag_rdf, crate:datalog, crate:ingress, crate:shacl,
        crate:sparql_parser, crate:turtle, crate:vqs_index, crate:jsonld_parser,
        crate:rml, crate:ottr .
crate:dagalog_kernel a bl:Crate ; rdfs:label "dagalog-kernel" ; bl:path "dagalog-kernel" ;
    bl:dependsOnCrate crate:ingress, crate:dag_rdf, crate:datalog, crate:datalog_parser,
        crate:sparql_parser, crate:turtle, crate:rml, crate:ottr,
        crate:owl2rl2datalog, crate:manchester_parser, crate:rdf_owl_translator, crate:shacl .
crate:dagalog a bl:Crate ; rdfs:label "dagalog" ; bl:path "." ;
    bl:dependsOnCrate crate:ingress, crate:dag_rdf, crate:owl_ontology, crate:owl2rl2datalog,
        crate:turtle, crate:rdf_owl_translator, crate:datalog, crate:datalog_parser,
        crate:sparql_parser, crate:sparql_endpoint, crate:rml, crate:ottr, crate:manchester_parser .
