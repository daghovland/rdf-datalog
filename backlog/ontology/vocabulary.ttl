@prefix bl: <https://dagalog.dev/ns/backlog#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The dagalog-on-dagalog backlog-mirror vocabulary. See issue #283
# <https://github.com/daghovland/rdf-datalog/issues/283> and
# MODELING_NOTES.md (this directory) for the reasoning behind every
# decision recorded here. Grounded against the fixtures in
# ../examples/ — every class/property below is exercised by at least
# one triple there.

<https://dagalog.dev/ns/backlog>
    a owl:Ontology ;
    rdfs:label "dagalog backlog vocabulary" ;
    rdfs:comment "Minimal vocabulary for mirroring a GitHub issue/PR backlog (and the codebase it tracks) as RDF, for the dagalog-on-dagalog self-hosting epic (#282)." ;
    owl:versionInfo "0.1.0-draft" .

# ── Classes ─────────────────────────────────────────────────────────────────

bl:WorkItem
    a rdfs:Class, owl:Class ;
    rdfs:label "Work item" ;
    rdfs:comment "The abstract common superclass of everything this ontology tracks as a unit of work to be done or already done -- currently bl:Issue and bl:PullRequest. Exists so those two can be disjoint siblings (see MODELING_NOTES.md \"bl:Issue and bl:PullRequest are disjoint\") while still sharing a type for properties that genuinely apply to both (bl:number, bl:state, bl:hasLabel, bl:touchesCrate -- plus rdfs:label for the title, see the note near bl:state)." .

bl:Issue
    a rdfs:Class, owl:Class ;
    rdfs:subClassOf bl:WorkItem ;
    rdfs:label "Issue" ;
    rdfs:comment "A GitHub issue (or work item, in Jira/Azure-DevOps terms). Subjects are the real GitHub issue URL — no invented identifier scheme. Disjoint from bl:PullRequest (see disjointness axioms below) -- a conceptually distinct kind of thing from a PR, even though GitHub's own internal data model blurs this (a PR IS technically an issue there, with extra fields)." .

bl:PullRequest
    a rdfs:Class, owl:Class ;
    rdfs:subClassOf bl:WorkItem ;
    rdfs:label "Pull request" ;
    rdfs:comment "A GitHub pull request. Revised (after review) from rdfs:subClassOf bl:Issue to a disjoint sibling under bl:WorkItem instead -- see MODELING_NOTES.md \"bl:Issue and bl:PullRequest are disjoint\" for why: a PR is conceptually a different kind of thing from an issue (it proposes a change and can merge/close code; an issue reports or requests something), even though it happens to share most of the same properties (number, state, hasLabel, touchesCrate -- all now declared on the common bl:WorkItem superclass instead; title uses rdfs:label, not a bespoke property)." .

bl:Epic
    a rdfs:Class, owl:Class ;
    rdfs:subClassOf bl:Issue ;
    rdfs:label "Epic" ;
    rdfs:comment "An issue explicitly marked as an epic. Revised from the original (PR #294) purely-structural definition (no bl:subIssueOf, target of some other issue's bl:subIssueOf) after review flagged that pattern's assumption of an exactly-two-level hierarchy: GitHub's native sub-issue relation nests arbitrarily, so a mid-tree issue (has both a parent and children) matched neither \"epic\" nor \"leaf\" under the old definition and silently vanished from either kind of query. bl:Epic is now an ASSERTED type (by the loader, #284, or by hand in these fixtures) with exactly one hard constraint, not a derived double-negation — see bl:EpicHasNoParentShape in shapes.ttl. Deliberately NOT required to have at least one bl:subIssueOf child: a freshly-filed epic legitimately has zero sub-issues until they're filed (e.g. #282 itself, briefly, when first created) — only \"has no parent\" is enforced, not \"has children\". No depth restriction is implied elsewhere: an Epic's own children may themselves have further children; whether a mid-tree node also gets asserted bl:Epic is a modeling choice made per-issue (by whoever/whatever asserts the type), not something this class definition dictates one way or the other. Remains rdfs:subClassOf bl:Issue (not bl:WorkItem) -- an epic is specifically a kind of issue, never a kind of pull request." .

bl:IssueState
    a rdfs:Class, owl:Class ;
    rdfs:label "Issue state" ;
    rdfs:comment "Controlled vocabulary for GitHub's own raw open/closed state (bl:state) — a purely technical field, distinct from the workflow-stage concept in bl:WorkflowStatus. See MODELING_NOTES.md \"Workflow status as its own axis\"." .

bl:Open a bl:IssueState ; rdfs:label "Open" .
bl:Closed a bl:IssueState ; rdfs:label "Closed" .

bl:WorkflowStatus
    a rdfs:Class, owl:Class ;
    rdfs:label "Workflow status" ;
    rdfs:comment "Controlled vocabulary for this repo's own Kanban/Jira-style workflow stage (bl:status) — independent of the raw bl:state. An issue can be bl:state bl:Open at every stage except bl:Done; bl:status only ever advances Todo -> Ready -> InProgress -> Done (this repo has no formal \"blocked\"/\"in review\" stage today, so none is modeled -- add one here first if this repo's practice grows one, rather than overloading an existing value)." .

bl:Todo
    a bl:WorkflowStatus ;
    rdfs:label "Todo" ;
    rdfs:comment "Filed, unlabeled, awaiting the repo owner's review (this repo's convention: an agent-filed issue starts here and must never self-advance past it)." .

bl:Ready
    a bl:WorkflowStatus, bl:Label ;
    rdfs:label "Ready" ;
    rdfs:comment "Reviewed and approved by the repo owner for an agent to pick up. Deliberately typed as BOTH bl:WorkflowStatus and bl:Label — this individual IS the GitHub \"ready\" label (bl:hasLabel bl:Ready) AND IS the corresponding workflow stage (bl:status bl:Ready): one resource, two properties pointing at it, not two independent facts that could drift apart. See MODELING_NOTES.md \"Labels as resources\"." .

bl:InProgress
    a bl:WorkflowStatus ;
    rdfs:label "In progress" ;
    rdfs:comment "Actively being worked. This repo has no GitHub label for this stage today — it's signaled by a working-branch comment on the issue instead, which a loader (#284) would need parsing/convention-detection logic to recognise, not just a label read." .

bl:Done
    a bl:WorkflowStatus ;
    rdfs:label "Done" ;
    rdfs:comment "Closed via a merged PR. Always coincides with bl:state bl:Closed, but is asserted separately rather than derived, since not every bl:Closed issue necessarily went through the ready/in-progress pipeline (e.g. closed as a duplicate or won't-fix)." .

bl:Label
    a rdfs:Class, owl:Class ;
    rdfs:label "Label" ;
    rdfs:comment "A GitHub label, as a controlled-vocabulary resource rather than a plain string. Revised from PR #294's original string-valued bl:hasLabel after review — see MODELING_NOTES.md \"Labels as resources\". Individuals are named per label actually used in ../examples/, not an exhaustive enumeration of every label this repo could ever use; add more as new labels appear." .

bl:Bug a bl:Label ; rdfs:label "bug" .
bl:Enhancement a bl:Label ; rdfs:label "enhancement" .
# bl:Ready is also a bl:Label — see its declaration above (bl:WorkflowStatus section).

bl:Crate
    a rdfs:Class, owl:Class ;
    rdfs:label "Crate" ;
    rdfs:comment "A Rust workspace member crate. See MODELING_NOTES.md \"DOAP vs. bespoke bl:Crate\" for why this isn't a DOAP term — a doap:Project is used instead for the repository as a whole, one level up." .

# ── Properties: Issue/PullRequest ────────────────────────────────────────────

bl:number
    a owl:DatatypeProperty ;
    rdfs:domain bl:WorkItem ;
    rdfs:range xsd:integer ;
    rdfs:label "number" ;
    rdfs:comment "The GitHub issue/PR number, for human-readable display — the IRI (the real GitHub URL) is already the actual identifier, this is not needed for identity." .

# NOTE: no bl:title property -- an issue/PR's title is given by rdfs:label
# directly (RDFS's own "human-readable name for the subject"), not a
# bespoke property. Reused deliberately: this vocabulary already uses
# rdfs:label as schema-level annotation on classes/properties/individuals
# (e.g. bl:Issue rdfs:label "Issue"); using it for instance-level titles too
# is standard RDF practice (rdfs:label is not reserved for schema terms)
# and avoids a redundant property that would say exactly the same thing.

bl:state
    a owl:ObjectProperty ;
    rdfs:domain bl:WorkItem ;
    rdfs:range bl:IssueState ;
    rdfs:label "state" ;
    rdfs:comment "GitHub's raw open/closed state. See bl:status for the separate workflow-stage axis." .

bl:status
    a owl:ObjectProperty ;
    rdfs:domain bl:Issue ;
    rdfs:range bl:WorkflowStatus ;
    rdfs:label "status" ;
    rdfs:comment "This repo's own Kanban-style workflow stage, independent of bl:state. Added per the Jira/Azure-DevOps/Kanban comparison in PR #293 -- not populated for every issue in ../examples/, since deriving it reliably (in particular detecting bl:InProgress, which has no GitHub label) is #284's (the loader's) job, not this vocabulary's. Where a bl:WorkflowStatus value has a directly corresponding bl:Label (currently just bl:Ready), #284 should derive bl:status for that value FROM the matching bl:hasLabel, not assert it independently -- see MODELING_NOTES.md \"Labels as resources\". Domain kept as bl:Issue, not bl:WorkItem: this repo's practice never gives a PR its own workflow stage distinct from bl:state (a PR is open, then merged/closed -- there's no separate ready/in-progress pipeline for a PR itself)." .

bl:hasLabel
    a owl:ObjectProperty ;
    rdfs:domain bl:WorkItem ;
    rdfs:range bl:Label ;
    rdfs:label "has label" ;
    rdfs:comment "A GitHub label (repeatable) — issues and PRs can both carry labels on GitHub. Resource-valued, not a plain string — see MODELING_NOTES.md \"Labels as resources\" for why this changed from PR #294's original string-valued design." .

bl:subIssueOf
    a owl:ObjectProperty ;
    rdfs:domain bl:Issue ;
    rdfs:range bl:Issue ;
    rdfs:label "sub-issue of" ;
    rdfs:comment "Mirrors GitHub's native sub-issue relation (child -> parent), which nests arbitrarily deep -- no depth restriction is implied by this property. Domain/range are bl:Issue, not bl:WorkItem: a PR is never a sub-issue of anything and never has sub-issues (GitHub's sub-issue relation is issue-only). See bl:Epic's comment and bl:EpicHasNoParentShape (shapes.ttl) for the one constraint this vocabulary does impose: an Epic must never have this property asserted on it." .

bl:closesIssue
    a owl:ObjectProperty ;
    rdfs:domain bl:PullRequest ;
    rdfs:range bl:Issue ;
    rdfs:label "closes issue" ;
    rdfs:comment "PR formally closes an issue on merge (a GitHub \"Closes #N\" reference). Distinct from bl:relatesToIssue -- see that property's comment for why the distinction matters." .

bl:relatesToIssue
    a owl:ObjectProperty ;
    rdfs:domain bl:PullRequest ;
    rdfs:range bl:Issue ;
    rdfs:label "relates to issue" ;
    rdfs:comment "PR references an issue without closing it -- e.g. it implements only part of the issue's scope. Kept distinct from bl:closesIssue so a loader (or a human) can never conflate \"this PR mentions #N\" with \"this PR resolved #N\" -- see PR #292/issue #161 in ../examples/valid_backlog_snapshot.ttl for a real case where collapsing the two would have been wrong." .

# ── Properties: crates ───────────────────────────────────────────────────────

bl:touchesCrate
    a owl:ObjectProperty ;
    rdfs:domain bl:WorkItem ;
    rdfs:range bl:Crate ;
    rdfs:label "touches crate" ;
    rdfs:comment "The crate(s) an issue or PR actually changed (or, for a still-open issue, is expected to change). Domain bl:WorkItem, not bl:Issue or bl:PullRequest specifically, since this is the main property genuinely shared by both -- a PR that already changed a crate, and an unresolved bug report that already knows which crate it affects before any fix exists." .

bl:dependsOnCrate
    a owl:ObjectProperty ;
    rdfs:domain bl:Crate ;
    rdfs:range bl:Crate ;
    rdfs:label "depends on crate" ;
    rdfs:comment "A direct (not transitive) Cargo path dependency, read straight off the dependent crate's own Cargo.toml -- not asserted transitively, so \"what (transitively) depends on X\" is a property-path SPARQL query (bl:dependsOnCrate+ in reverse), not a separate stored relation, to avoid a second source of truth that could drift from Cargo.toml." .

# NOTE: no bl:name property either -- same reasoning as bl:title above. A
# crate's Cargo package name is its rdfs:label (not always identical to the
# directory name, which is bl:path -- e.g. directory dag_rdf is package
# dag-rdf).

bl:path
    a owl:DatatypeProperty ;
    rdfs:domain bl:Crate ;
    rdfs:range xsd:string ;
    rdfs:label "path" ;
    rdfs:comment "Workspace-relative directory of the crate." .

bl:partOfProject
    a owl:ObjectProperty ;
    rdfs:domain bl:Crate ;
    rdfs:range <http://usefulinc.com/ns/doap#Project> ;
    rdfs:label "part of project" ;
    rdfs:comment "Links a workspace crate to the enclosing doap:Project. See MODELING_NOTES.md \"DOAP vs. bespoke bl:Crate\" for why the repository as a whole reuses real DOAP terms while individual crates use the bespoke bl:Crate class." .

# ── Disjointness ─────────────────────────────────────────────────────────────
#
# See MODELING_NOTES.md "Disjointness axioms" for the reasoning, including
# the one deliberate exception (bl:Label / bl:WorkflowStatus are NOT
# declared disjoint, since bl:Ready is intentionally typed as both).
#
# Group 1: every top-level class here is pairwise disjoint from every other
# EXCEPT bl:WorkflowStatus, which is asserted disjoint separately below so
# it can stay un-disjoint from bl:Label specifically. bl:WorkItem here
# (rather than bl:Issue/bl:PullRequest individually) covers both subclasses
# automatically via subsumption -- a reasoner running full OWL-RL over this
# data would derive bl:Issue and bl:PullRequest are each disjoint from
# bl:Crate/bl:IssueState/bl:Label/doap:Project without a separate assertion.
[] a owl:AllDisjointClasses ;
    owl:members ( bl:WorkItem bl:Crate bl:IssueState bl:Label <http://usefulinc.com/ns/doap#Project> ) .

# Group 2: the same top-level classes, with bl:WorkflowStatus substituted
# for bl:Label -- entails bl:WorkflowStatus disjoint from bl:WorkItem/Crate/
# IssueState/doap:Project, and re-asserts (harmlessly) that those four are
# mutually disjoint. Neither group ever lists bl:Label and bl:WorkflowStatus
# together, so no disjointness between THEM is entailed.
[] a owl:AllDisjointClasses ;
    owl:members ( bl:WorkItem bl:Crate bl:IssueState bl:WorkflowStatus <http://usefulinc.com/ns/doap#Project> ) .

# Sibling subclasses of bl:WorkItem: an issue is never a pull request and
# vice versa (see bl:Issue/bl:PullRequest's comments and MODELING_NOTES.md
# "bl:Issue and bl:PullRequest are disjoint"). This is the load-bearing
# disjointness axiom in this vocabulary, since neither class is a subclass
# of the other any more.
bl:Issue owl:disjointWith bl:PullRequest .

# NOT separately asserted: bl:PullRequest owl:disjointWith bl:Epic. It's
# already entailed (bl:Epic rdfs:subClassOf bl:Issue, and bl:Issue is now
# disjoint from bl:PullRequest above, so bl:Epic inherits that disjointness
# through subsumption) -- asserting it again would be redundant, not an
# independent fact.
