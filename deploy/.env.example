# Copy this file to deploy/.env and fill in real values. deploy/.env is
# gitignored (see .gitignore) -- never commit real secrets here.
#
# See docs/deploy/PUBLIC_DEPLOYMENT.md for how to obtain each value.

# The domain name you've pointed at this server's IP (A record). Caddy uses
# this both for routing and to request a Let's Encrypt certificate for it.
PUBLIC_DOMAIN=dagalog.example.com

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client ID (Web application). Authorized redirect URI must be
# https://<PUBLIC_DOMAIN>/oauth2/callback -- see PUBLIC_DEPLOYMENT.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Random 32-byte value oauth2-proxy uses to encrypt session cookies. Generate
# with: python3 -c 'import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=

# Self-hosted Keycloak identity provider (#532), replacing Google. Generate
# a random DB password the same way as OAUTH2_PROXY_COOKIE_SECRET above.
# KEYCLOAK_ADMIN_USER/PASSWORD are bootstrap credentials for the one-time
# admin-console step of creating your own real user account -- not meant
# for day-to-day sign-in, and not the same as your dagalog login.
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
