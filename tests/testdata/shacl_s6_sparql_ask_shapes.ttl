@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/ns#> .

ex:AgeShape
    a sh:NodeShape ;
    sh:targetClass ex:Person ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "age must be non-negative" ;
        sh:ask """
            ASK { $this ex:age ?age . FILTER (?age >= 0) }
        """ ;
    ] .
