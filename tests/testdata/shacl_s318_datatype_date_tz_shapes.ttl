# Issue #318 regression — see shacl_s318_datatype_date_tz_data.ttl.
# https://github.com/daghovland/rdf-datalog/issues/318
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX ex: <http://example.com/ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:DateTzShape
    a sh:NodeShape ;
    sh:targetNode ex:PlainDate, ex:ZuluDate, ex:OffsetDate, ex:BadDate ;
    sh:property [
        sh:path ex:when ;
        sh:datatype xsd:date ;
    ] .
