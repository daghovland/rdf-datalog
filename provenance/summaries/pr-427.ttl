@prefix agp: <https://dagalog.dev/ns/agentprov#> .
@prefix bl: <https://dagalog.dev/ns/backlog#> .
@prefix ghissues: <https://github.com/daghovland/rdf-datalog/issues/> .
@prefix ghpull: <https://github.com/daghovland/rdf-datalog/pull/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix session: <https://dagalog.dev/ns/agentprov/session#> .

# PROSPECTIVE summary scaffold, generated by scripts/new-provenance-summary.sh.
# TODO: replace the placeholder summaryText/decisionPoint below with the
# actual distilled reasoning behind this PR before committing — see
# docs/plans/TRANSCRIPT_SUMMARY_GUIDELINES.md. Timestamps below are real
# (from `git log main..HEAD` on branch feat/381-backlog-dashboard-shell); everything else that
# isn't marked TODO can be left as-is.

ghpull:427 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "sparql_endpoint: backlog dashboard page shell + issue/epic board (#381)" ;
    bl:number 427 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:381 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr427 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:381 ;
    prov:startedAtTime "2026-08-08T15:58:17Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-08-08T15:58:17Z"^^xsd:dateTime .

session:pr427Summary a agp:TranscriptSummary ;
    agp:summaryText "Issue #381 asked for a page shell plus an issue/epic board on a new GET /backlog route, hardcoding bl:/agp: IRIs rather than reusing frontend.html's generic discovery (that file is deliberately schema-agnostic and already conflicts with #42/#47). Before writing any HTML/JS, ran the SPARQL queries directly against scripts/serve-backlog.sh's real local dataset to settle two open questions rather than assume: whether bl:Epic individuals are also asserted a bl:Issue (yes, all 22 are, so a board query matching only bl:Issue would not silently miss them even without a reasoner running), and how populated bl:status actually is (only 113 of 244 issues have any status, all bl:Ready -- confirming the vocabulary's own comment that bl:InProgress has no derivable label yet). That second finding directly shaped the board: a strict four-column Todo/Ready/InProgress/Done layout would have dropped over half of open issues from view, so a fifth 'No status recorded' bucket was added. The freshness banner (#380's bl:generatedAt) was also checked against real data before wiring it up: the checked-in snapshot.ttl predates that predicate (0 matching triples), so the banner renders an honest 'unknown, regenerate with backlog-regenerate' message instead of fabricating a date. Epic drill-down uses a client-side recursive render over all bl:subIssueOf edges (not a property path query) so the tree shape survives, with a visited-set cycle guard since the property is conventionally acyclic but not structurally enforced -- verified real chains go 3+ levels deep, so the recursion path is genuinely exercised by this repo's own data, not just defensive code." ;
    agp:reasoningFor ghpull:427 ;
    prov:wasGeneratedBy session:pr427 ;
    prov:wasAttributedTo session:claudeSonnet5 ;
    agp:decisionPoint session:pr427Decision .

session:pr427Decision a agp:Decision ;
    agp:summaryText "Excluded bl:Epic individuals from the open-issue board (FILTER NOT EXISTS { ?issue a bl:Epic }) and gave epics their own dedicated drill-down section instead of a board card alongside ordinary issues." ;
    agp:alternative "Considered showing epics as board cards too, keyed by their own bl:status like any other issue. Rejected because an epic sitting in a status column next to its own children (which can have different, more granular statuses) reads as misleading -- the board's status columns describe leaf work, not the aggregate state of a tree; a separate section makes the epic/child relationship the primary axis instead of forcing it into the same status grouping." .
