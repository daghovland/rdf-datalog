ghpull:708 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "sparql_endpoint: support explain=true with transactional (txId) reads (#574)" ;
    bl:number 708 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:574 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr708 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:574 ;
    prov:startedAtTime "2026-10-08T12:44:08Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-10-08T12:56:50Z"^^xsd:dateTime .

session:pr708Summary a agp:TranscriptSummary ;
    agp:summaryText "run_transactional_query executed queries against a snapshot+pending-delta view via its own code path, bypassing the explain handling #537 added to run_select_query -- so explain=true combined with a txId parameter previously hard-errored with 400. By the time this issue was picked up, #572/#573/#697 had substantially extended the explain machinery since #537 originally landed (a runtime per-operator profiler and a more precise static already_bound set), so the fix read all three PRs' summaries first to understand the current shape of explain.rs before touching it. The actual fix was straightforward once that context was in hand: threaded an explain: bool parameter into run_transactional_query and, when true, called the same explain_query_response core run_select_query uses, but against the transaction's own snapshot+delta view rather than the live store -- removing the now-unnecessary explain_with_tx_id_unsupported short-circuit entirely rather than leaving a narrower special case. Two red-phase tests pin the exact two properties that matter: the explain report sees the pending transaction's uncommitted insert (proving it queries the delta view, not a stale snapshot), and that view's changes never leak into the live store (proving explain is still read-only against the transaction, not an accidental commit path)." ;
    agp:reasoningFor ghpull:708 ;
    prov:wasGeneratedBy session:pr708 ;
    prov:wasAttributedTo session:claudeSonnet5 .
