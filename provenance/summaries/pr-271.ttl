@prefix agp: <https://dagalog.no/ns/agentprov#> .
@prefix bl: <https://dagalog.no/ns/backlog#> .
@prefix ghissues: <https://github.com/daghovland/rdf-datalog/issues/> .
@prefix ghpull: <https://github.com/daghovland/rdf-datalog/pull/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix session: <https://dagalog.no/ns/agentprov/session#> .

# Retrospective transcript summary, backfilled for issue #355 (full backfill
# follow-up to the #352 sample), distilling PR #271's own body/commit history --
# no live session context was available (this PR predates or was outside this
# backfill session), per docs/plans/TRANSCRIPT_SUMMARY_GUIDELINES.md's
# retrospective case. Timestamps are real, from `gh pr view 271 --json
# commits,mergedAt`: startedAtTime is the first commit's authoredDate, endedAtTime is the PR's actual mergedAt.

ghpull:271 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "fix(shacl): node-level (pathless) value constraints on a shape are silently dropped" ;
    bl:number 271 ;
    bl:state bl:Closed ;
    bl:closesIssue ghissues:260 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr271 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:260 ;
    prov:startedAtTime "2026-07-23T20:28:55Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-07-24T07:58:36Z"^^xsd:dateTime .

session:pr271Summary a agp:TranscriptSummary ;
    agp:summaryText "Node shapes with sh:datatype/sh:in/sh:class/sh:hasValue/etc. directly on the shape (no sh:path) currently have those constraints silently dropped: parse_prop_constraints is only called inside the if let Some(path_id) = ... SH_PATH branch of parse_one_shape. Adds regression tests (currently red) reproducing the bug for sh:datatype, sh:in, sh:class, sh:hasValue. Implementation in progress. Work-in-progress PR opened early per repo workflow to avoid losing context across restarts." ;
    agp:reasoningFor ghpull:271 ;
    prov:wasGeneratedBy session:pr271 ;
    prov:wasAttributedTo session:claudeSonnet5 .
