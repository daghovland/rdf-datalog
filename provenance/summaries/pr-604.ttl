# PROSPECTIVE summary scaffold, generated by scripts/new-provenance-summary.sh.
# TODO: replace the placeholder summaryText/decisionPoint below with the
# actual distilled reasoning behind this PR before committing — see
# docs/plans/TRANSCRIPT_SUMMARY_GUIDELINES.md. Timestamps below are real
# (from `git log main..HEAD` on branch issue-528-claude-md-exception); everything else that
# isn't marked TODO can be left as-is.

ghpull:604 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "docs: remove CLAUDE.md's contradictory trivial-doc-update exception" ;
    bl:number 604 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:528 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr604 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:528 ;
    prov:startedAtTime "2026-08-13T22:23:27+02:00"^^xsd:dateTime ;
    prov:endedAtTime "2026-08-29T07:25:17Z"^^xsd:dateTime .

session:pr604Summary a agp:TranscriptSummary ;
    agp:summaryText "Issue #528 flagged that CLAUDE.md's Implementation workflow section ended with an 'Exception: trivial single-file documentation updates ... may be committed directly to main without a worktree or PR' line that directly contradicted the hard no-direct-pushes-to-main rule already recorded elsewhere in the same file, and that this contradiction had already forced an ad hoc override once during #353 rather than being fixed at the source. This was small and unambiguous enough to fix directly rather than delegate to a sub-agent: removed the exception line entirely and replaced it with an explicit statement that no exception exists, so the rule reads unambiguously without requiring out-of-band instructions to ignore the contradictory line. Went through the normal worktree/branch/PR flow for this change, which is itself the point being enforced." ;
    agp:reasoningFor ghpull:604 ;
    prov:wasGeneratedBy session:pr604 ;
    prov:wasAttributedTo session:claudeSonnet5 .
