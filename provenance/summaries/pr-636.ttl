ghpull:636 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "manchester_parser: implement SWRL Rule: frames" ;
    bl:number 636 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:498 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr636 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:498 ;
    prov:startedAtTime "2026-09-04T14:47:52Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-09-06T11:57:56Z"^^xsd:dateTime .

session:pr636Summary a agp:TranscriptSummary ;
    agp:summaryText "Issue #498 (item 1 of the #157 umbrella, following #503's DisjointUnionOf: as the template for how a deferred grammar production gets added) asked for SWRL Rule: frames in manchester_parser. Checked provenance for crate:manchester_parser first (PR #158's original parser, PR #288's serializer, which already logged SWRL/deferred constructs as skipped) before starting. The scaffolded ignored test only asserted parse() succeeds, with no fixed grammar to match, so the actual work was designing a concrete grammar subset: atoms as classAtom (description '(' arg ')', tried first so every unary atom is a ClassAtom) or genericAtom (iri '(' arg,... ')', arity 2 as PropertyAtom, other arities as BuiltInAtom), args as variable/literal/individual. Wrote a plan-doc addendum documenting this before any tests, per TDD convention, then unignored/expanded the scaffolded test and added four more (named-individual args, leading Annotations:, multi-atom head, interleaving with Class: frames), then implemented rule.rs and wired it into lib.rs's top-level parse loop, then added serialize.rs emission plus a round-trip test." ;
    agp:reasoningFor ghpull:636 ;
    prov:wasGeneratedBy session:pr636 ;
    prov:wasAttributedTo session:claudeSonnet5 ;
    agp:decisionPoint session:pr636Decision .

session:pr636Decision a agp:Decision ;
    agp:summaryText "SWRL rules are held on a new, separate Ontology.rules: Vec<SwrlRule> field rather than as a new Axiom::AxiomRule variant. Ontology::new's signature is unchanged (rules defaults empty); a with_rules builder attaches them, so no existing Ontology::new call site needed updating." ;
    agp:alternative "Considered adding Axiom::AxiomRule(SwrlRule) instead, since Ontology.axioms is already the single collection point frame parsing feeds into. Rejected: Axiom is matched exhaustively (no wildcard arm) by owl2rl2datalog::owl_to_rdf's RDF-translation walk and by other exhaustive matches across the workspace, none of which have any RDF/datalog form to translate a SWRL rule into -- every one of those match sites would need a new arm for a construct outside their scope. SWRL is also a distinct W3C submission from OWL 2, not an OWL 2 axiom category, so a separate field is the semantically correct model, not just a workaround." .
