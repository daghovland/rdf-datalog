@prefix bl: <https://dagalog.no/ns/backlog#> .
@prefix ghissues: <https://github.com/daghovland/rdf-datalog/issues/> .
@prefix ghpull: <https://github.com/daghovland/rdf-datalog/pull/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix session: <https://dagalog.no/ns/agentprov/session#> .

# Retrospective transcript summary, backfilled for issue #355 (full backfill
# follow-up to the #352 sample), distilling PR #253's own body/commit history --
# no live session context was available (this PR predates or was outside this
# backfill session), per docs/plans/TRANSCRIPT_SUMMARY_GUIDELINES.md's
# retrospective case. Timestamps are real, from `gh pr view 253 --json
# commits,mergedAt`: startedAtTime is the first commit's authoredDate, endedAtTime is the PR's actual mergedAt.

ghpull:253 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "fix(sparql-endpoint): reject application/rdf+xml uploads instead of silently parsing as Turtle" ;
    bl:number 253 ;
    bl:state bl:Closed ;
    bl:closesIssue ghissues:251 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr253 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:251 ;
    prov:startedAtTime "2026-07-23T09:30:12Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-07-23T09:46:12Z"^^xsd:dateTime .

session:pr253Summary a agp:TranscriptSummary ;
    agp:summaryText "rdf_upload_format (used by all Graph Store Protocol upload routes in graph_store.rs) mapped application/rdf+xml to UploadFormat::Turtle, so a client uploading genuine RDF/XML with the correct content-type got it silently fed to the Turtle parser — at best a parse error, at worst near-silent data loss. This was inconsistent with sparql_update.rs's LOAD handler, which already returns an explicit \"not yet supported\" error for the same content-type. Fix: rdf_upload_format now falls through to None for application/rdf+xml, giving callers the same honest 415 Unsupported Media Type every other unrecognised content-type already gets (all four call sites already handle None this way — verified before making the change). RDF/XML support itself is tracked separately under epic #240; this issue is scoped to fixing the silent mis-parse, not implementing the parser." ;
    agp:reasoningFor ghpull:253 ;
    prov:wasGeneratedBy session:pr253 ;
    prov:wasAttributedTo session:claudeSonnet5 .
