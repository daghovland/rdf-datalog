ghpull:795 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "sparql_parser: allow BOUND/REGEX/ISBLANK/etc. nested inside IF()/COALESCE()" ;
    bl:number 795 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:674 .

