ghpull:436 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "scripts/serve-backlog.sh: pass --cors-allow-origin to dagalog" ;
    bl:number 436 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:435 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr436 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:435 ;
    prov:startedAtTime "2026-08-09T15:09:49Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-08-09T15:09:49Z"^^xsd:dateTime .

session:pr436Summary a agp:TranscriptSummary ;
    agp:summaryText "backlog_endpoint runs as its own process/origin (localhost:3031) from the dagalog SPARQL endpoint it queries (localhost:3030), so its sparqlFetch calls are cross-origin POST /sparql requests. dagalog's CORS policy (#362) only auto-approves cross-origin GET/HEAD for any origin -- POST requires the origin to be in --cors-allow-origin, which scripts/serve-backlog.sh never passed when starting dagalog, so every dashboard query failed with a browser NetworkError. Confirmed the root cause with curl (Origin header + OPTIONS preflight) before touching code: no access-control-allow-origin header appeared without the flag, and it appeared once passed. Fixed by adding --cors-allow-origin http://localhost:$DASHBOARD_PORT to the script's dagalog invocation, updated backlog_endpoint/README.md's manual-run section to document the same requirement, and added a regression test asserting the flag's presence in the script text so a future edit can't silently drop it again." ;
    agp:reasoningFor ghpull:436 ;
    agp:decisionPoint session:pr436Decision ;
    prov:wasGeneratedBy session:pr436 ;
    prov:wasAttributedTo session:claudeSonnet5 .

session:pr436Decision a agp:Decision ;
    agp:summaryText "Passed --cors-allow-origin twice -- once for http://localhost:$DASHBOARD_PORT and once for http://127.0.0.1:$DASHBOARD_PORT (the flag is repeatable). Verification with curl on non-default ports (to avoid colliding with any already-running dev server) plus a negative control caught that a browser can report either hostname form depending on how the dashboard URL was opened, and dagalog's CORS allow-list (sparql_endpoint::server::build_allow_origin) does exact string matching with no hostname normalization or wildcard support -- allowlisting only one form would leave the other silently broken." ;
    agp:alternative "Normalizing localhost/127.0.0.1 at the CORS-matching layer itself (in sparql_endpoint::server::build_allow_origin) so a single allowlisted origin covers both forms. Rejected for this PR's scope: that would be a behavior change to the shared CORS policy affecting every dagalog deployment, not just this one wrapper script's startup arguments -- a bigger, separate change than fixing serve-backlog.sh's own missing flag." .
