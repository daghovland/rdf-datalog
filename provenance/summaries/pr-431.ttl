ghpull:431 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "backlog: regenerate snapshot.ttl to populate bl:touchesFile (#395)" ;
    bl:number 431 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:395 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr431 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:395 ;
    prov:startedAtTime "2026-08-08T23:44:16+02:00"^^xsd:dateTime ;
    prov:endedAtTime "2026-08-08T22:00:19Z"^^xsd:dateTime .

session:pr431Summary a agp:TranscriptSummary ;
    agp:summaryText "backlog/examples/snapshot.ttl predated #358's loader change that asserts bl:touchesFile alongside bl:touchesCrate, so related_to_file.sparql's shipped worked example (shacl/src/evaluate.rs, a real file touched by PR #300) returned zero rows against the checked-in snapshot -- the query itself was correct, only the fixture data was stale. Ran cargo run -p backlog --bin backlog-regenerate against live gh api data to refresh the snapshot: went from 0 to 4218 bl:touchesFile triples (bl:touchesCrate's 305 triples were already current, since #358 only just added the file-level assertion). Confirmed the fix by actually running provenance/queries/run.sh related_to_file against the regenerated data rather than just trusting the triple count -- it now returns 4 real transcript summaries (PRs #297, #300, #328, #410) reasoning about shacl/src/evaluate.rs, matching the query file's own documented example. Also updated provenance/queries/README.md's note describing this as an open gap, since it no longer is." ;
    agp:reasoningFor ghpull:431 ;
    prov:wasGeneratedBy session:pr431 ;
    prov:wasAttributedTo session:claudeSonnet5 .
