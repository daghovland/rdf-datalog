@prefix agp: <https://dagalog.no/ns/agentprov#> .
@prefix bl: <https://dagalog.no/ns/backlog#> .
@prefix ghissues: <https://github.com/daghovland/rdf-datalog/issues/> .
@prefix ghpull: <https://github.com/daghovland/rdf-datalog/pull/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix session: <https://dagalog.no/ns/agentprov/session#> .

# PROSPECTIVE summary scaffold, generated by scripts/new-provenance-summary.sh.
# TODO: replace the placeholder summaryText/decisionPoint below with the
# actual distilled reasoning behind this PR before committing — see
# docs/plans/TRANSCRIPT_SUMMARY_GUIDELINES.md. Timestamps below are real
# (from `git log 9e3b93121c93c971061b4ed0f0f4c34d6166c4b4..HEAD` on branch docs/691-draft-pr-workflow); everything else that
# isn't marked TODO can be left as-is.

ghpull:692 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "docs: use draft PRs instead of stale 'not ready for review' body text" ;
    bl:number 692 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:691 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr692 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:691 ;
    prov:startedAtTime "2026-10-01T14:15:21Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-10-01T14:15:21Z"^^xsd:dateTime .

session:pr692Summary a agp:TranscriptSummary ;
    agp:summaryText "The user directly flagged that PR #690 (issue #670) still said \"Not yet ready for review\" in its body even though the work was actually finished and CI had gone green -- the early-minimal-PR convention (push a WIP PR immediately to avoid losing work on this interruption-prone environment, per CLAUDE.md's existing guidance) left a free-text status marker that nobody reliably updates once the real work wraps up. Considered just reminding agents to remember to update the text, but rejected that since it's the same failure mode recurring (a human/agent-maintained invariant that silently drifts). Replaced it with GitHub's own draft-PR mechanism instead: open the early PR with gh pr create --draft, then gh pr ready <N> once CI is green and the body is finalized at step 6. The draft/ready flag is state GitHub itself tracks and surfaces in the PR list UI, so it can't go stale the way a sentence in the body can -- the fix addresses the structural cause (prose as a status signal) rather than just the one instance." ;
    agp:reasoningFor ghpull:692 ;
    prov:wasGeneratedBy session:pr692 ;
    prov:wasAttributedTo session:claudeSonnet5 .

