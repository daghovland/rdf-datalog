ghpull:774 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "fix: CLEAR/DROP and owl:Nothing rollback bypassing the reasoner (#591)" ;
    bl:number 774 ;
    bl:state bl:Open ;
