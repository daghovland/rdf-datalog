ghpull:484 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "sparql_endpoint: replace naked unwrap() in bind-address parsing" ;
    bl:number 484 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:461 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr484 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:461 ;
    prov:startedAtTime "2026-08-15T07:44:56Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-08-15T07:44:56Z"^^xsd:dateTime .

session:pr484Summary a agp:TranscriptSummary ;
    agp:summaryText "Issue #461 (part of the 2026-08 code-quality self-review, epic #453) flagged the one naked production unwrap() in sparql_endpoint: Config::default()'s bind_addr field parsed the literal \"0.0.0.0:3030\" with .parse().unwrap(). Before fixing, grepped sparql_endpoint/src for every remaining .unwrap() not already wrapped in .expect() to confirm the issue's premise still held after other recent PRs — all hits were confined to #[cfg(test)] modules (auth.rs, persistence.rs, sparql_update.rs, query_builder.rs), so the framing was accurate. Fixed by switching to .expect(\"hardcoded bind address is valid\"), matching the .expect(...) convention already used for infallible-in-practice values elsewhere in the crate, and added a small unit test (config_tests::default_bind_addr_parses) so a future edit to the literal that broke parsing would fail loudly at test time rather than only at process startup. While running the full workspace quality gate, hit two unrelated flakes caused by other agents' worktrees building/testing concurrently on the same machine: a SIGBUS linker crash from a nearly-full shared CARGO_TARGET_DIR, and an rml json_tests failure from a fixture collision on a fixed /tmp path — both confirmed as environment noise (re-running in isolation passed) rather than caused by this change; the fixture-collision one was filed as a standalone follow-up, issue #487." ;
    agp:reasoningFor ghpull:484 ;
    agp:decisionPoint session:pr484Decision ;
    prov:wasGeneratedBy session:pr484 ;
    prov:wasAttributedTo session:claudeSonnet5 .

session:pr484Decision a agp:Decision ;
    agp:summaryText "Chose Config::default()'s existing runtime .parse::<SocketAddr>() call plus .expect(\"hardcoded bind address is valid\"), matching the .expect(...) convention already used elsewhere in this crate for infallible-in-practice values." ;
    agp:alternative "Considered replacing the literal with a compile-time const SocketAddr (e.g. built via SocketAddr::V4 from literal octets in a const fn), which the issue itself suggested as an option. Rejected: bind_addr sits inside a plain runtime Default impl with no other const-context constraints, so a const would add ceremony (manual octet construction instead of a readable string literal) without removing any real risk — the literal is trivially correct and covered by the new test." .
