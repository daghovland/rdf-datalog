# Transcript summary for PR #634 (issue #181), per
# docs/plans/TRANSCRIPT_SUMMARY_GUIDELINES.md. Timestamps are real, from
# `git log main..HEAD` on branch feat/181-owl-functional-syntax-serializer.

ghpull:634 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "OWL 2 Functional-Style Syntax serializer (owl_ontology::Ontology -> .ofn)" ;
    bl:number 634 ;
