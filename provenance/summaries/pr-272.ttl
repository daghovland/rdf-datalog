@prefix agp: <https://dagalog.no/ns/agentprov#> .
@prefix bl: <https://dagalog.no/ns/backlog#> .
@prefix ghissues: <https://github.com/daghovland/rdf-datalog/issues/> .
@prefix ghpull: <https://github.com/daghovland/rdf-datalog/pull/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix session: <https://dagalog.no/ns/agentprov/session#> .

# Retrospective transcript summary, backfilled for issue #355 (full backfill
# follow-up to the #352 sample), distilling PR #272's own body/commit history --
# no live session context was available (this PR predates or was outside this
# backfill session), per docs/plans/TRANSCRIPT_SUMMARY_GUIDELINES.md's
# retrospective case. Timestamps are real, from `gh pr view 272 --json
# commits,mergedAt`: startedAtTime is the first commit's authoredDate, endedAtTime is the PR's actual mergedAt.

ghpull:272 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "fix(shacl): distinguish rdf:langString from xsd:string in sh:datatype" ;
    bl:number 272 ;
    bl:state bl:Closed ;
    bl:closesIssue ghissues:259 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr272 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:259 ;
    prov:startedAtTime "2026-07-23T20:30:06Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-07-23T20:37:37Z"^^xsd:dateTime .

session:pr272Summary a agp:TranscriptSummary ;
    agp:summaryText "shacl::evaluate::literal_datatype_iri mapped both RdfLiteral::LangLiteral and RdfLiteral::LiteralString to xsd:string, so sh:datatype xsd:string incorrectly accepted language-tagged literals and sh:datatype rdf:langString incorrectly accepted plain strings. Per RDF 1.1, a language-tagged literal's datatype IRI is rdf:langString, distinct from xsd:string. Added ingress::RDF_LANG_STRING alongside the existing RDF/RDFS/OWL/XSD namespace constants and split the match arm accordingly." ;
    agp:reasoningFor ghpull:272 ;
    prov:wasGeneratedBy session:pr272 ;
    prov:wasAttributedTo session:claudeSonnet5 .
