# Timestamps below are real (from `git log main..HEAD` on branch
# feat/603-caddyfile-ci-validation).

ghpull:652 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "ci: validate deploy/Caddyfile syntax (caddy validate)" ;
    bl:number 652 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:603 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr652 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:603 ;
