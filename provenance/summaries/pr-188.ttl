# commits,mergedAt`: startedAtTime is the first commit's authoredDate, endedAtTime is the PR's actual mergedAt.

ghpull:188 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "feat(sparql): join reordering Phase C-2 — hoist independent conjuncts before OPTIONAL/MINUS" ;
    bl:number 188 ;
