ghpull:734 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "sparql_endpoint: migrate utoipa 5.5->6.0, utoipa-swagger-ui 9.0->10.0" ;
    bl:number 734 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:725 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr734 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:725 ;
    prov:startedAtTime "2026-10-30T15:06:53Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-10-30T15:23:48Z"^^xsd:dateTime .

session:pr734Summary a agp:TranscriptSummary ;
    agp:summaryText "Issue #725 was the deferred real fix behind #724's zip RUSTSEC workaround: three zip advisories (RUSTSEC-2026-0367/-0368/-0369) only resolve via zip>=9.0.0, which arrives transitively through utoipa-swagger-ui>=10.0 and utoipa>=6.0, a breaking API bump. #724 had deliberately deferred this because sparql_endpoint/src/openapi.rs -- the one file the bump breaks -- was being concurrently edited by #517's in-flight OpenAPI docs PR; landing the bump then would have guaranteed a conflict. With #517 merged, this PR did the actual migration: bumped both deps, then fixed the resulting utoipa 6.0 compile break (Vec<Parameter>::insert needing RefOr<Parameter> wrapping) and removed the now-unneeded zip ignore entries from .cargo/audit.toml once cargo audit confirmed clean." ;
    agp:reasoningFor ghpull:734 ;
    prov:wasGeneratedBy session:pr734 ;
    prov:wasAttributedTo session:claudeSonnet5 ;
    agp:decisionPoint session:pr734Decision .

session:pr734Decision a agp:Decision ;
    agp:summaryText "Fixed only the 4 call sites that actually broke (direct Vec::insert on an already-built Operation's parameters field in dataset_data_path_item()), rather than touching every path_param()/query_param() call site in the file." ;
    agp:alternative "Wrapping every path_param()/query_param() call in RefOr::T(...) uniformly was rejected as unnecessary churn: all the other ~15 call sites go through a builder's .parameter()/.parameters() method, which still accepts a bare Parameter via Into<RefOr<Parameter>> coercion under utoipa 6.0 -- only the handful bypassing the builder via raw Vec::insert needed the explicit wrap, confirmed by letting the compiler point at exactly those 4 sites rather than guessing." .
