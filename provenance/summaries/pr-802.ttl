ghpull:802 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "sparql_endpoint: generic OIDC Authorization Code + PKCE browser sign-in" ;
    bl:number 802 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:531 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr802 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:531 ;
    prov:startedAtTime "2026-11-15T12:21:29Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-11-15T12:21:29Z"^^xsd:dateTime .

session:pr802Summary a agp:TranscriptSummary ;
    agp:summaryText "Issue #531 noted that frontend.html's interactive sign-in only wired up MSAL.js, so non-Azure OIDC providers (Google, Keycloak, Auth0 — AUTH.md Tier 2b) had no browser sign-in button at all, just a manual bearer-token paste. First checked whether auth.rs's JWT validation itself was Azure-specific: it isn't — it already discovers JWKS from any configured issuer's /.well-known/openid-configuration and validates signature/issuer/audience generically, confirmed by the existing oidc_auth.rs tests passing unchanged. So this stayed a frontend+config change, not new validation logic. Implemented a standards Authorization Code + PKCE flow directly against crypto.subtle (no new JS dependency), selected via a new OidcConfig.browser_flow field (default Msal, so existing Entra ID deployments are unaffected) rather than replacing MSAL.js outright, per the issue's explicit 'additive, not a replacement' framing." ;
    agp:decisionPoint session:pr802Decision ;
    agp:reasoningFor ghpull:802 ;
    prov:wasGeneratedBy session:pr802 ;
    prov:wasAttributedTo session:claudeSonnet5 .

session:pr802Decision a agp:Decision ;
    agp:summaryText "Chose to use the ID token (not the access token) as the Bearer credential for the generic PKCE flow. AUTH.md's pre-existing Tier 2b Google example sets OidcConfig.audience to the OAuth client ID — which is the ID token's aud claim, not something Google's access tokens carry by default for an arbitrary resource. Validated this is consistent rather than inventing a new convention." ;
    agp:alternative "Considered sending the access_token instead (matches the MSAL.js path, where scope requests an audience-scoped access token). Rejected for the generic/Google case because an access token's aud only matches OidcConfig.audience if the provider is separately configured with a resource/audience parameter — out of scope here, and would have silently broken against the exact Google setup AUTH.md already documents." .
