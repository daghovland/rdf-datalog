session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr655 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:499 ;
    prov:startedAtTime "2026-09-12T10:04:53Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-09-12T10:13:30Z"^^xsd:dateTime .

session:pr655Summary a agp:TranscriptSummary ;
    agp:summaryText "Issue #499 asked for the Class: frame's HasKey: section (Axiom::AxiomHasKey), the third of six grammar productions split out of umbrella issue #157, using #503 (DisjointUnionOf:) as the template. The main open question was how to classify each item in HasKey:'s property list as an object- vs data-property expression, since the W3C grammar makes propertyExpression ::= objectPropertyExpression | dataPropertyExpression syntactically ambiguous for a bare IRI (only 'inverse IRI' is unambiguous). Rather than inventing new disambiguation machinery, this reused the pre-existing ParserContext::is_known_data_property table (populated by lib.rs's document-order-independent DataProperty: pre-scan), already relied on by class_expr::restriction and the EquivalentProperties:/DisjointProperties: misc forms for the identical problem. A second decision: the spec's HasKey: property list is space-separated, not comma-separated like every other Class: frame section's annotated lists (SubClassOf:, DisjointUnionOf:, etc.) — confirmed against the W3C Manchester Syntax grammar rather than assumed from the file's existing comma-separated patterns. Implementation added both parsing (frame.rs) and, following #503's precedent of shipping serialization alongside parsing rather than leaving it as a second follow-up, the reverse direction in serialize.rs (previously a log::warn!-skip stub for AxiomHasKey), with round-trip test coverage." ;
    agp:reasoningFor ghpull:655 ;
    prov:wasGeneratedBy session:pr655 ;
    prov:wasAttributedTo session:claudeSonnet5 .
