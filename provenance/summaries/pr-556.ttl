ghpull:556 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "owl2rl2datalog: implement HasKey axiom RDF encoding for the named-class case" ;
    bl:number 556 ;
    bl:state bl:Open ;
    bl:closesIssue ghissues:511 .

session:claudeSonnet5 a prov:SoftwareAgent ;
    rdfs:label "Claude Sonnet 5" .

session:pr556 a agp:AgentSession ;
    prov:wasAssociatedWith session:claudeSonnet5 ;
    prov:used ghissues:511 ;
    prov:startedAtTime "2026-08-13T22:23:27+02:00"^^xsd:dateTime ;
    prov:endedAtTime "2026-08-18T18:08:38Z"^^xsd:dateTime .

session:pr556Summary a agp:TranscriptSummary ;
    agp:summaryText "Issue #511 (split from #373) asked for the RDF encoding of owl:hasKey axioms, previously entirely undispatched in Translator::axiom (silently produced zero triples). The issue itself flagged that HasKey on a complex class expression needs #509's not-yet-built blank-node structural encoding, and explicitly scoped the named-class case as landable first. Rather than assume the W3C OWL 2 Mapping to RDF Graphs spec's exact triple shape, fetched and read the spec's HasKey table directly: T(C) owl:hasKey T(SEQ OPE1...OPEm DPE1...DPEn) -- confirming a named class's T(C) is just its bare IRI, with no blank node needed on the subject side (only the rdf:List cells for the key-property sequence need one). This matched the existing DisjointUnionOf implementation in the same file closely enough that the existing rdf_list helper could be reused directly rather than writing new list-encoding logic. Property ordering was a design point worth testing explicitly: the spec's SEQ requires object properties before data properties, in each group's declared order -- a dedicated test with two object and two data properties pins this rather than relying on the happy-path single-property test to accidentally get ordering right. For the complex-class-expression case, followed the file's existing skip() convention (used elsewhere for other not-yet-encodable axiom shapes) instead of inventing new error handling, and did not file a duplicate follow-up issue since #509 already tracks exactly that gap." ;
    agp:reasoningFor ghpull:556 ;
    prov:wasGeneratedBy session:pr556 ;
    prov:wasAttributedTo session:claudeSonnet5 .

