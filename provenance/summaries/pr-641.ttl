ghpull:641 a bl:PullRequest, bl:WorkItem ;
    rdfs:label "sparql_endpoint: per-ruleset-scoped DELETE /{dataset}/rules/{ruleset-id}" ;
    bl:number 641 ;
    bl:state bl:Open ;
