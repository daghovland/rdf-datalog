# "All decision points across the backlog" -- flatten agp:decisionPoint
# across every agp:TranscriptSummary, for a review dashboard. Not
# parameterized: runs over the whole loaded provenance/ dataset.

PREFIX agp: <https://dagalog.no/ns/agentprov#>

# Deliberately does NOT also join agp:alternative here: a decision point can
# have several repeatable agp:alternative values, and joining them in would
# multiply each decision's row once per alternative -- this query answers
# "what are the decision points", one row per agp:Decision, not "what are
# all the rejected alternatives". Query the decision resource's
# agp:alternative separately if that finer detail is needed.
SELECT ?summary ?decision ?summaryText WHERE {
  ?summary a agp:TranscriptSummary ;
    agp:decisionPoint ?decision .
  ?decision agp:summaryText ?summaryText .
}
ORDER BY ?summary ?decision
